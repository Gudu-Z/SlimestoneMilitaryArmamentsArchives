---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---
<header class="page-head">
  <nav class="breadcrumb" aria-label="面包屑"><slot name="breadcrumb" /></nav>
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {description && <p class="page-description">{description}</p>}
  <div class="page-meta"><slot /></div>
</header>
