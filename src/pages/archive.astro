---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import { getCollection } from 'astro:content';
import { PROJECTIONS, CATEGORIES } from '../data/projections';

// 给每个文件带上稳定锚点序号（与搜索索引一致），并按分类分组
const filesWithIndex = PROJECTIONS.map((p, i) => ({ ...p, idx: i + 1 }));
const grouped = CATEGORIES.map((cat) => ({
  cat,
  files: filesWithIndex.filter((f) => f.category === cat),
})).filter((g) => g.files.length > 0);

const rarCount = PROJECTIONS.filter((p) => p.title.endsWith('.rar')).length;

const articles = await getCollection('articles');
const appendix = articles.find((a) => a.data.tag === 'APPENDIX');
---

<Base
  title="投影档案馆 · 军用绿萌军备档案馆"
  description="军用绿萌军备开源机器投影档案馆——按分类浏览并下载 .litematic 投影文件。"
>
  <main class="page" id="main-content">
    <div class="container">
      <PageHeading eyebrow="SMA / SCHEMATIC LIBRARY" title="投影档案馆" description="从基础模块到完整飞船，查找结构、下载投影，为你的下一次建造积累灵感。">
        <Fragment slot="breadcrumb"><a href="/#home">首页</a><span aria-hidden="true">/</span><span aria-current="page">档案馆</span></Fragment>
        <span>{grouped.length} 个分类</span><span>{PROJECTIONS.length - rarCount} 个投影</span><span>{rarCount} 个合集</span>
      </PageHeading>
      <div class="archive-layout">
        <aside class="archive-directory">
          <p class="eyebrow">INDEX / 分类索引</p>
          <nav class="cat-nav" aria-label="投影分类">
            {grouped.map((g, i) => <a href={`#cat-${i}`}><span>{g.cat}</span><span class="directory-count">{String(g.files.length).padStart(2, '0')}</span></a>)}
          </nav>
          <p class="directory-tip">也可以通过顶部搜索框，按文件名或分类查找。</p>
        </aside>
        <div class="archive-content">
          <div class="download-note"><span class="note-label">使用说明</span><p><strong>.litematic</strong> 文件使用 <a href={appendix ? `/articles/${appendix.id}/` : '/tutorials/'}>Litematica 投影模组</a>载入；<strong>.rar</strong> 为打包合集，请先解压。</p></div>
          {grouped.map((g, i) => (
            <section class="cat-section" id={`cat-${i}`} aria-labelledby={`cat-title-${i}`}>
              <div class="category-heading">
                <span class="category-number">{String(i + 1).padStart(2, '0')}</span>
                <h2 id={`cat-title-${i}`}>{g.cat}</h2>
                <span class="category-total">{g.files.length} 个文件</span>
              </div>
              <div class="file-list">
                {g.files.map((f) => {
                  const isRar = f.title.endsWith('.rar');
                  const href = `/投影文件/${encodeURIComponent(f.category)}/${encodeURIComponent(f.title)}`;
                  return (
                    <div id={`f-${f.idx}`} class={`file-item${isRar ? ' file-item--yellow' : ''}`}>
                      <span class="file-icon" title={isRar ? '压缩合集' : 'Litematica 投影'}>{isRar ? 'RAR' : 'LIT'}</span>
                      <span class="file-name">{f.title}</span>
                      <a class="file-dl" href={href} download aria-label={`下载 ${f.title}`}>下载 <span aria-hidden="true">↓</span></a>
                    </div>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </main>
</Base>
