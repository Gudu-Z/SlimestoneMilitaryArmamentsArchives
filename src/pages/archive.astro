---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import ProjectionDialog from '../components/ProjectionDialog.astro';
import { getCollection } from 'astro:content';
import { getProjections, getProjectionCategories } from '../lib/projections';

const projections = await getProjections();
const grouped = getProjectionCategories(projections).map((cat) => ({
  cat,
  files: projections.filter((f) => f.category === cat),
}));

const rarCount = projections.filter((p) => p.format === 'RAR').length;

const articles = await getCollection('articles');
const appendix = articles.find((a) => a.data.tag === 'APPENDIX');
---

<Base
  title="投影档案馆 · 军用绿萌军备档案馆"
  description="军用绿萌军备开源机器投影档案馆——按分类浏览并下载 .litematic 投影文件。"
>
  <main class="page" id="main-content">
    <div class="container">
      <PageHeading eyebrow="SMA / SCHEMATIC LIBRARY" title="投影档案馆" description="从基础模块到完整飞船，查找结构、下载投影，为你的下一次建造积累灵感。">
        <Fragment slot="breadcrumb"><a href="/#home">首页</a><span aria-hidden="true">/</span><span aria-current="page">档案馆</span></Fragment>
        <span>{grouped.length} 个分类</span><span>{projections.length - rarCount} 个投影文件</span><span>{rarCount} 个压缩包</span>
      </PageHeading>
      <div class="archive-layout">
        <aside class="archive-directory">
          <p class="eyebrow">INDEX / 分类索引</p>
          <nav class="cat-nav" aria-label="投影分类">
            {grouped.map((g, i) => <a href={`#cat-${i}`}><span>{g.cat}</span><span class="directory-count">{String(g.files.length).padStart(2, '0')}</span></a>)}
          </nav>
          <p class="directory-tip">点击文件名称查看图片与资料，也可以通过顶部搜索框查找。</p>
        </aside>
        <div class="archive-content">
          <div class="download-note"><span class="note-label">使用说明</span><p><strong>.litematic</strong> 文件使用 <a href={appendix ? `/articles/${appendix.id}/` : '/tutorials/'}>Litematica 投影模组</a>载入；<strong>.rar</strong> 为压缩包，可能包含投影合集或游戏存档，请先解压并查看条目说明。</p></div>
          {grouped.map((g, i) => (
            <section class="cat-section" id={`cat-${i}`} aria-labelledby={`cat-title-${i}`}>
              <div class="category-heading">
                <span class="category-number">{String(i + 1).padStart(2, '0')}</span>
                <h2 id={`cat-title-${i}`}>{g.cat}</h2>
                <span class="category-total">{g.files.length} 个文件</span>
              </div>
              <div class="file-list">
                {g.files.map((f) => {
                  const isRar = f.format === 'RAR';
                  return (
                    <div id={f.legacyId || `file-${f.id}`} class={`file-item${isRar ? ' file-item--yellow' : ''}`}>
                      <span class="file-icon" title={isRar ? 'RAR 压缩包' : 'Litematica 投影'}>{isRar ? 'RAR' : 'LIT'}</span>
                      <a class="file-detail" href={f.detailUrl} data-projection-id={f.id} aria-haspopup="dialog" aria-label={`查看 ${f.title} 的详情`}><span class="file-name">{f.fileName}</span><span class="file-detail-hint" aria-hidden="true">↗</span></a>
                      <a class="file-dl" href={f.url} download aria-label={`下载 ${f.fileName}`}>下载 <span aria-hidden="true">↓</span></a>
                    </div>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </main>
  <ProjectionDialog projections={projections} />
</Base>
